# OdontoScan AI — variáveis de ambiente (backend)
# Copie para .env e ajuste conforme necessário.

# Tamanho máximo do upload em MB
MAX_UPLOAD_MB=15

# Limiar de confiança da detecção (ajustado via sweep no val do DENTEX)
CONF_THRESHOLD=0.40

# IoU do Non-Maximum Suppression
NMS_IOU=0.45

# Inferências simultâneas (semáforo)
MAX_CONCURRENCY=2

# Número máximo de frames aceitos em DICOM (v1 aceita apenas 1)
MAX_FRAMES=1

# Caminho do modelo .onnx; vazio = usa o stub determinístico
# Padrão (panorâmico, CC BY-NC-4.0): caries, periapical_lesion, impacted_tooth.
MODEL_PATH=models/liodon_dental_panoramic.onnx
# Alternativa permissiva (Apache-2.0), menos precisa em panorâmica:
# MODEL_PATH=models/dental_pathology_detector.onnx

# Permitir fallback para o stub quando o modelo real está ausente/inválido
ALLOW_STUB_FALLBACK=true

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Recorta automaticamente a faixa da panorâmica (remove cabeçalho/rodapé/insets)
AUTO_CROP_PANORAMA=true
# Só recorta se remover ao menos esta fração da área (evita recorte inútil)
CROP_MIN_GAIN=0.05

# Descarta detecções sobre material radiopaco (restauração/implante/coroa).
# DESLIGADO por padrão: no val do DENTEX ele reduz mais recall que falsos positivos.
SUPPRESS_RADIOPAQUE=false
# Fração mínima de pixels claros na caixa para descartar a detecção
RADIOPAQUE_THRESHOLD=0.35
# Intensidade (0-255) a partir da qual um pixel é considerado radiopaco
RADIOPAQUE_INTENSITY=200

# --- Etapa 4: autenticação + histórico (ADR-0007) ---
# Banco (SQLite na v1; Postgres depois, com Alembic)
DATABASE_URL=sqlite:///./data/odontoscan.db

# Segredo HMAC do JWT — OBRIGATÓRIO, mín. 16 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem default em produção: a aplicação falha rápido se ausente.
JWT_SECRET=troque-por-um-segredo-forte-de-verdade

# Validade do access token (minutos) e do refresh token (dias)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Tentativas de login por minuto (por IP + e-mail). Em memória na v1;
# em produção precisa ser distribuído (Redis/gateway).
LOGIN_RATE_LIMIT=5

# Limite isolado por IP (somado ao de cima). Evita burlar o limite por e-mail
# rotacionando o e-mail no mesmo IP. O login só passa se AMBOS estiverem no limite.
LOGIN_IP_RATE_LIMIT=20
